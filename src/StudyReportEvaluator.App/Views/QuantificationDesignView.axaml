<UserControl
    x:Class="StudyReportEvaluator.App.Views.QuantificationDesignView"
    x:DataType="viewModels:QuantificationDesignViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:StudyReportEvaluator.App.ViewModels"
    Background="{DynamicResource AppCanvasBrush}"
    Foreground="{DynamicResource AppTextBrush}"
    AutomationProperties.AutomationId="QuantificationDesignView">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.editor">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.prompt">
      <Setter Property="Background" Value="#EEF1FF" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.ok">
      <Setter Property="Background" Value="{DynamicResource AppCompletedSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCompletedBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.invalid">
      <Setter Property="Background" Value="{DynamicResource TechnicalBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TechnicalBorderBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /></Style>
    <Style Selector="Button">
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
      <Setter Property="ToolTip.Tip" Value="この操作を実行します。" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
      <Setter Property="ToolTip.Tip" Value="この項目の値を入力または確認します。" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
      <Setter Property="ToolTip.Tip" Value="候補から設定する値を選びます。" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
      <Setter Property="ToolTip.Tip" Value="この設定を有効または無効にします。" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
      <Setter Property="ToolTip.Tip" Value="一覧から編集または確認する項目を選びます。" />
    </Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AppAccentBrush}" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="TextBox:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" /><Setter Property="BorderThickness" Value="3" /></Style>
    <Style Selector="ListBox.navigator"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="ListBox.question-cards">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.question-cards ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.question-cards ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Border.question-card">
      <Setter Property="Width" Value="400" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.formula-guide">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,3" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.formula-chip">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.formula-base">
      <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.formula-question">
      <Setter Property="Background" Value="{DynamicResource AppCompletedSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCompletedBrush}" />
    </Style>
    <Style Selector="Border.formula-rate">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="Border.formula-special">
      <Setter Property="Background" Value="{DynamicResource TechnicalBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TechnicalBorderBrush}" />
    </Style>
    <Style Selector="Border.formula-penalty">
      <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border
        x:Name="FormulaGuide"
        Grid.Row="0"
        Margin="24,24,24,0"
        Classes="formula-guide"
        AutomationProperties.AutomationId="DesignFormulaGuide"
        AutomationProperties.Name="採点計算式と現在の設定値">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="採点計算式" FontSize="18" FontWeight="SemiBold" />
            <TextBlock
                Text="同じ色の設定値が式のどこで使われるかを示します。学生ごとの R・L・平均は実行時に計算されます。"
                Classes="muted"
                TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock
              Grid.Column="1"
              Text="各項目にマウスを合わせると説明を表示"
              Classes="muted"
              FontSize="12"
              TextWrapping="Wrap"
              VerticalAlignment="Center" />
        </Grid>

        <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5">
            <TextBlock
              Text="設問獲得点"
              FontWeight="Bold"
              VerticalAlignment="Center"
              ToolTip.Tip="その設問の絶対配点 Pq と、実行時に得る通常評価率 Rq の積です。" />
          <TextBlock Text="=" VerticalAlignment="Center" />
          <Border Classes="formula-chip formula-question" ToolTip.Tip="その設問に割り当てる絶対配点 Pq です。">
            <TextBlock Text="設問配点 Pq" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="×" VerticalAlignment="Center" />
          <Border Classes="formula-chip formula-rate" ToolTip.Tip="AIのcriterion結果を正規化・加重平均した通常評価率 Rq（0～1）です。実行時に計算されます。">
            <TextBlock Text="通常評価率 Rq（実行時）" FontWeight="SemiBold" />
          </Border>
        </WrapPanel>

        <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5">
            <TextBlock
              Text="設問減点"
              FontWeight="Bold"
              VerticalAlignment="Center"
              ToolTip.Tip="その設問の絶対配点 Pq、類似度 Lq、類似度減点係数 W の積です。" />
          <TextBlock Text="=" VerticalAlignment="Center" />
          <Border Classes="formula-chip formula-question" ToolTip.Tip="その設問に割り当てる絶対配点 Pq です。">
            <TextBlock Text="設問配点 Pq" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="×" VerticalAlignment="Center" />
          <Border Classes="formula-chip formula-rate" ToolTip.Tip="学生回答と参照回答の類似度 Lq（0～1）です。実行時に計算されます。">
            <TextBlock Text="類似度 Lq（実行時）" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="×" VerticalAlignment="Center" />
          <Border Classes="formula-chip formula-penalty" ToolTip.Tip="類似度を何点分の減点へ反映するかを調整する係数 W（0～1）です。">
            <TextBlock Text="類似度減点係数 W" FontWeight="SemiBold" />
          </Border>
        </WrapPanel>

        <WrapPanel Orientation="Horizontal" ItemSpacing="5" LineSpacing="5">
          <TextBlock Text="FinalRaw" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Text="=" VerticalAlignment="Center" />
          <Border Classes="formula-chip formula-base" ToolTip.Tip="すべての提出へ共通で加算する基礎点 B です。">
            <TextBlock Text="Base B" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="+" VerticalAlignment="Center" />
          <Border Classes="formula-chip formula-question" ToolTip.Tip="有効な全設問の獲得点を合計します。">
            <TextBlock Text="Σ 設問獲得点" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="+" VerticalAlignment="Center" />
          <Border Classes="formula-chip formula-special" ToolTip.Tip="各設問内の有効な固有評価を等分平均し、固有評価がある有効設問間でも等分平均して、Special pointsを掛けます。">
            <TextBlock Text="SpecialEarned" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="−" VerticalAlignment="Center" />
          <Border Classes="formula-chip formula-penalty" ToolTip.Tip="有効な全設問の類似度減点を合計して差し引きます。">
            <TextBlock Text="Σ 設問減点" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="·" VerticalAlignment="Center" />
          <TextBlock Text="FinalScore" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Text="= FinalRaw がblankならblank、それ以外は clamp(FinalRaw, 0, 100)" VerticalAlignment="Center" TextWrapping="Wrap" />
        </WrapPanel>

        <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="7">
          <Border Classes="formula-chip formula-base" ToolTip.Tip="現在のBase pointsです。定義情報のBase pointsと同じ値です。">
            <WrapPanel Orientation="Horizontal" ItemSpacing="4">
              <TextBlock Text="Base" FontWeight="SemiBold" />
              <TextBlock x:Name="FormulaBaseValue" Text="{Binding BasePoints, StringFormat='{}{0:G29}'}" AutomationProperties.AutomationId="FormulaBaseValue" />
            </WrapPanel>
          </Border>
          <Border Classes="formula-chip formula-special" ToolTip.Tip="現在のSpecial pointsです。0の場合は固有評価AIを実行しません。正の値には1件以上の有効な固有評価が必要です。">
            <WrapPanel Orientation="Horizontal" ItemSpacing="4">
              <TextBlock Text="Special" FontWeight="SemiBold" />
              <TextBlock x:Name="FormulaSpecialValue" Text="{Binding SpecialPoints, StringFormat='{}{0:G29}'}" AutomationProperties.AutomationId="FormulaSpecialValue" />
            </WrapPanel>
          </Border>
          <Border Classes="formula-chip formula-penalty" ToolTip.Tip="現在の類似度減点係数です。0なら類似度による減点はありません。">
            <WrapPanel Orientation="Horizontal" ItemSpacing="4">
              <TextBlock Text="係数 W" FontWeight="SemiBold" />
              <TextBlock x:Name="FormulaSimilarityValue" Text="{Binding SimilarityPenaltyWeight, StringFormat='{}{0:G29}'}" AutomationProperties.AutomationId="FormulaSimilarityValue" />
            </WrapPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Questions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="7" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:QuestionDesignItemViewModel">
                <Border Classes="formula-chip formula-question" ToolTip.Tip="この設問の絶対配点です。全設問の配点とBase、Specialの合計を正確に100にします。">
                  <WrapPanel Orientation="Horizontal" ItemSpacing="4">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Points, StringFormat='{}{0:G29} pt'}" />
                  </WrapPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>

        <TextBlock
          Text="通常評価、必要な固有評価、参照回答、類似度の技術的失敗は0点に変換せずblankとしてFinalRawとFinalScoreへ伝播します。丸め桁数は表示用で、配点合計は丸めず正確に100を判定します。"
            Classes="muted"
            FontSize="12"
            TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer
      x:Name="QuantificationDesignScrollViewer"
      Grid.Row="1"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto"
      AutomationProperties.AutomationId="QuantificationDesignScrollViewer">
    <StackPanel Margin="24,14,24,24" Spacing="14" HorizontalAlignment="Stretch" KeyboardNavigation.TabNavigation="Continue">
      <Border Background="{DynamicResource AppHeroBrush}" CornerRadius="18" Padding="20">
        <StackPanel Spacing="6">
          <TextBlock Text="STEP 02 · QUANTIFICATION DESIGN" Foreground="#9FABFF" FontWeight="SemiBold" />
          <TextBlock Text="動的な定量化 tree" Foreground="White" FontSize="27" FontWeight="Bold" />
          <TextBlock Text="全設問をカードで比較し、選択した設問の評価方法・評価項目・Promptを詳しく編集します。" Foreground="{DynamicResource AppHeroMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="IMPORTED PROMPTS" Classes="heading" />
          <TextBlock
              Text="command lineの指定順を保持します。選択したtargetへ明示適用するまでdraftやAI処理は変更しません。"
              Classes="muted"
              TextWrapping="Wrap" />
          <ListBox
              x:Name="ImportedPromptList"
              ItemsSource="{Binding ImportedPrompts}"
              SelectedItem="{Binding SelectedImportedPrompt, Mode=TwoWay}"
              Height="100"
              AutomationProperties.AutomationId="ImportedPrompts"
              AutomationProperties.Name="command lineから読み込んだPrompt一覧"
              ToolTip.Tip="起動時に --prompt で読み込んだPromptです。選択しただけでは設計へ反映されません。">
            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="viewModels:ImportedPromptViewModel">
                <TextBlock Text="{Binding DisplayName}" Margin="8,4" TextWrapping="Wrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBox
              x:Name="ImportedPromptPreview"
              Text="{Binding ImportedPromptPreview}"
              IsReadOnly="True"
              AcceptsReturn="True"
              TextWrapping="Wrap"
              Height="120"
              AutomationProperties.AutomationId="ImportedPromptPreview"
              AutomationProperties.Name="選択したimported Prompt本文preview"
              ToolTip.Tip="選択したPrompt本文の読取専用プレビューです。適用は設問へのコピーだけで、AI処理は実行画面で開始するまで行われません。" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBlock Text="Prompt適用先の設問:" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock
                x:Name="SelectedPromptTargetSummary"
                Grid.Column="1"
                Text="{Binding SelectedPromptTargetSummary}"
                TextWrapping="Wrap"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SelectedPromptTargetSummary" />
              </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <ComboBox
                ItemsSource="{Binding AvailablePromptTargets}"
                SelectedItem="{Binding SelectedPromptTargetChoice, Mode=TwoWay}"
                AutomationProperties.AutomationId="ImportedPromptTarget"
                AutomationProperties.Name="Promptを適用するtarget"
                ToolTip.Tip="Promptのコピー先を、選択中の設問にあるCustom評価方法または固有評価から選びます。">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:ImportedPromptTargetChoice">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button
                x:Name="ApplyImportedPromptButton"
                Grid.Column="1"
                Content="Promptを適用"
                Command="{Binding ApplyImportedPromptCommand}"
                AutomationProperties.AutomationId="ApplyImportedPrompt"
                AutomationProperties.Name="選択Promptを選択targetへcopy"
                ToolTip.Tip="選択したPrompt本文を、表示中の設問名とtargetへコピーします。AI処理は開始しません。" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="定義情報" Classes="heading" />
          <TextBlock Text="定義名" Classes="label" />
          <TextBox x:Name="DefinitionNameTextBox" Text="{Binding DefinitionName, Mode=TwoWay}" AutomationProperties.AutomationId="DesignDefinitionName" ToolTip.Tip="この採点設計を識別する名前を入力します。結果workbookの定義情報にも保存されます。" />
          <TextBlock Text="revision" Classes="label" />
          <TextBox Text="{Binding Revision, Mode=TwoWay}" ToolTip.Tip="授業内で設計の版を区別する文字列を入力します。採点計算そのものには使いません。" />
          <TextBlock Text="丸め桁数（0～6）" Classes="label" />
          <TextBox Text="{Binding RoundingDigits, Mode=TwoWay}" ToolTip.Tip="表示する小数点以下の桁数を0～6で入力します。配点合計の正確な100判定には丸め値を使いません。" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <StackPanel Grid.Column="0" Spacing="5">
              <TextBlock Text="Base points" Classes="label" />
              <TextBox
                  x:Name="BasePointsTextBox"
                  Text="{Binding BasePoints, Mode=TwoWay}"
                  AutomationProperties.AutomationId="DesignBasePoints"
                  AutomationProperties.Name="基礎配点 Base points"
                  ToolTip.Tip="全提出へ共通で加算する基礎点です。0～100で入力し、Specialと有効設問配点との合計を正確に100にします。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Text="Special points" Classes="label" />
              <TextBox
                  x:Name="SpecialPointsTextBox"
                  Text="{Binding SpecialPoints, Mode=TwoWay}"
                  AutomationProperties.AutomationId="DesignSpecialPoints"
                  AutomationProperties.Name="固有評価の総配点 Special points"
                  ToolTip.Tip="固有評価全体へ割り当てる配点です。0～100で入力します。正の値には1件以上の有効な固有評価が必要です。" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock Text="類似度減点係数（0～1）" Classes="label" />
              <TextBox
                  x:Name="SimilarityPenaltyWeightTextBox"
                  Text="{Binding SimilarityPenaltyWeight, Mode=TwoWay}"
                  AutomationProperties.AutomationId="DesignSimilarityPenaltyWeight"
                  AutomationProperties.Name="類似度減点係数"
                  ToolTip.Tip="設問配点と類似度に掛ける減点係数です。0～1で入力し、0なら類似度による減点はありません。" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock
                x:Name="AllocationSummaryText"
                Text="{Binding AllocationSummary}"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="DesignAllocationSummary" />
            <Button
                x:Name="EqualizeQuestionPointsButton"
                Grid.Column="1"
                Content="設問配点を均等化"
                Command="{Binding EqualizeQuestionPointsCommand}"
                AutomationProperties.AutomationId="EqualizeQuestionPoints"
                AutomationProperties.Name="残り配点を有効な設問へ均等配分"
                ToolTip.Tip="100からBaseとSpecialを引いた残りを、有効な設問へ均等配分します。このボタンを押した場合だけ手動配点を置き換えます。" />
          </Grid>
          <TextBlock Text="{Binding SourceSummary}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding HierarchySummary}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="設問一覧（すべて表示）" Classes="heading" />
          <TextBlock
              Text="各カードで設問内容と配点を確認・編集できます。カードを選ぶと、その設問の評価方法・固有評価・Promptを下で編集します。"
              Classes="muted"
              TextWrapping="Wrap" />
          <Button Classes="primary" Content="質問を追加" Command="{Binding AddQuestionCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="AddDesignQuestion" ToolTip.Tip="新しい設問を末尾へ追加します。既存設問の手動配点は変更しません。" />
          <ListBox
              x:Name="QuestionEditorList"
              Classes="question-cards"
              ItemsSource="{Binding Questions}"
              SelectedItem="{Binding SelectedQuestion, Mode=TwoWay}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Disabled"
              AutomationProperties.AutomationId="DesignQuestions"
              ToolTip.Tip="すべての設問カードを表示します。カードを選ぶと、その設問の評価詳細とPrompt適用先が切り替わります。">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel
                    Orientation="Horizontal"
                    ItemSpacing="10"
                    LineSpacing="10"
                    AutomationProperties.AutomationId="QuestionCardPanel" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="viewModels:QuestionDesignItemViewModel">
                <Border
                    Classes="question-card"
                    AutomationProperties.AutomationId="{Binding CardAutomationId}"
                    AutomationProperties.Name="{Binding DisplayName}">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="設問カード" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentStrongBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding EffectiveWeightText}" FontWeight="SemiBold" />
                    </Grid>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                      <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="有効" ToolTip.Tip="この設問を現在のrunに含めるか設定します。変更しても他の設問配点は自動変更しません。" />
                      <Button Content="複製" Command="{Binding DuplicateCommand}" ToolTip.Tip="この設問と評価設定を複製し、新しい一意な識別子で直後へ追加します。" />
                      <Button Content="上へ" Command="{Binding MoveUpCommand}" ToolTip.Tip="この設問を一覧で1つ前へ移動します。" />
                      <Button Content="下へ" Command="{Binding MoveDownCommand}" ToolTip.Tip="この設問を一覧で1つ後ろへ移動します。" />
                      <Button Content="削除" Command="{Binding DeleteCommand}" ToolTip.Tip="この設問と配下の評価設定をdraftから削除します。" />
                    </WrapPanel>
                    <TextBlock Text="質問の表示名" Classes="label" />
                    <TextBox Text="{Binding DisplayName, Mode=TwoWay}" AutomationProperties.AutomationId="{Binding NameAutomationId}" ToolTip.Tip="画面と結果で設問を識別する名前を入力します。" />
                    <TextBlock Text="設問 text" Classes="label" />
                    <TextBox Text="{Binding QuestionText, Mode=TwoWay}" TextWrapping="Wrap" ToolTip.Tip="学生へ提示した設問文を確認・修正します。参照回答生成と通常評価の文脈に使われます。" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="質問配点（絶対点）" Classes="label" />
                        <TextBox Text="{Binding Points, Mode=TwoWay}" AutomationProperties.AutomationId="{Binding WeightAutomationId}" ToolTip.Tip="この設問の絶対配点を0以上で入力します。Base、Special、全有効設問配点の合計を正確に100にします。" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="主回答列" Classes="label" />
                        <TextBlock Text="{Binding PrimarySourceColumn}" TextWrapping="Wrap" VerticalAlignment="Center" MinHeight="44" ToolTip.Tip="入力画面で選んだ、この設問の主回答列です。変更は入力画面で行います。" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="補助列" Classes="label" />
                    <TextBlock Text="{Binding SupportingColumnsText}" TextWrapping="Wrap" ToolTip.Tip="同じ回答行から評価の補助情報として送る列です。変更は入力画面で行います。" />
                    <TextBlock Text="{Binding ValidationText}" IsVisible="{Binding HasErrors}" Foreground="{DynamicResource TechnicalTextBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <ContentControl Content="{Binding SelectedQuestion}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="viewModels:QuestionDesignItemViewModel">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="選択した設問の評価詳細" Classes="heading" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Text="編集中の設問:" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Grid>
                <TextBlock
                    Text="設問自体の内容と配点は上のカードで編集します。ここでは評価方法、評価項目、固有評価、Promptを設定します。"
                    Classes="muted"
                    TextWrapping="Wrap" />

                <TextBlock Text="固有評価 navigator" Classes="heading" />
                <Button
                    Content="固有評価を追加"
                    Command="{Binding AddSpecialEvaluationCommand}"
                    HorizontalAlignment="Left"
                  AutomationProperties.Name="この質問へ固有評価を追加"
                    ToolTip.Tip="この設問へ、任意の主対象列を0～1で定量化する固有評価を追加します。" />
                <ListBox
                    Classes="navigator"
                    ItemsSource="{Binding SpecialEvaluations}"
                    SelectedItem="{Binding SelectedSpecialEvaluation, Mode=TwoWay}"
                    Height="100"
                    AutomationProperties.Name="この質問の固有評価一覧"
                    ToolTip.Tip="選択中の設問にある固有評価です。選ぶと下の編集欄が切り替わります。">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SpecialEvaluationDesignItemViewModel">
                      <Grid Margin="8,4" ColumnDefinitions="2*,*" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding PrimarySourceColumn, StringFormat='主対象 {0}'}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <ContentControl Content="{Binding SelectedSpecialEvaluation}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="viewModels:SpecialEvaluationDesignItemViewModel">
                      <Border Classes="editor" AutomationProperties.AutomationId="{Binding CardAutomationId}">
                        <StackPanel Spacing="8">
                          <TextBlock Text="選択した固有評価" Classes="heading" />
                          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="有効" ToolTip.Tip="この固有評価を現在のrunへ含めるか設定します。" />
                            <Button Content="複製" Command="{Binding DuplicateCommand}" ToolTip.Tip="この固有評価を新しい一意な識別子で複製します。" />
                            <Button Content="上へ" Command="{Binding MoveUpCommand}" ToolTip.Tip="この固有評価を一覧で1つ前へ移動します。" />
                            <Button Content="下へ" Command="{Binding MoveDownCommand}" ToolTip.Tip="この固有評価を一覧で1つ後ろへ移動します。" />
                            <Button Content="削除" Command="{Binding DeleteCommand}" ToolTip.Tip="この固有評価をdraftから削除します。" />
                          </WrapPanel>
                          <TextBlock Text="固有評価名" Classes="label" />
                          <TextBox Text="{Binding DisplayName, Mode=TwoWay}" ToolTip.Tip="この固有評価を識別する名前を入力します。" />
                          <TextBlock Text="主対象列" Classes="label" />
                          <ComboBox
                              ItemsSource="{Binding AvailableColumnNames}"
                              SelectedItem="{Binding PrimarySourceColumn, Mode=TwoWay}"
                              AutomationProperties.Name="固有評価の主対象列"
                              ToolTip.Tip="固有評価で0～1へ定量化する主対象列を選びます。主対象列は補助列と重複できません。" />
                          <TextBlock Text="補助列（0件以上）" Classes="label" />
                          <ListBox
                              ItemsSource="{Binding SupportingColumns}"
                              Height="110"
                              AutomationProperties.Name="固有評価の補助列"
                              ToolTip.Tip="同じ回答行から固有評価の補助情報として送る列を0件以上選びます。">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                              <DataTemplate x:DataType="viewModels:SpecialSupportingColumnSelectionViewModel">
                                <CheckBox
                                    Content="{Binding ColumnName}"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSelect}"
                                  ToolTip.Tip="この列を固有評価の補助情報に含めます。主対象列と同じ列は選べません。"
                                  ToolTip.ShowOnDisabled="True" />
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                          <Border Classes="prompt">
                            <StackPanel Spacing="6">
                              <TextBlock Text="固有評価 Prompt（回答 placeholder 必須）" FontWeight="Bold" />
                              <TextBox
                                  Text="{Binding PromptTemplate, Mode=TwoWay}"
                                  AcceptsReturn="True"
                                  TextWrapping="Wrap"
                                  Height="120"
                                  AutomationProperties.AutomationId="{Binding PromptAutomationId}"
                                  ToolTip.Tip="固有評価の指示を入力します。{回答} placeholderが必須で、AIは0～1の値だけを返します。" />
                            </StackPanel>
                          </Border>
                          <TextBlock Text="{Binding ValidationText}" IsVisible="{Binding HasErrors}" Foreground="{DynamicResource TechnicalTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <TextBlock Text="評価方法 navigator" Classes="heading" />
                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                  <Button Content="Knowledgeを追加" Command="{Binding AddKnowledgeEvaluatorCommand}" ToolTip.Tip="説明・関係・適用をapp-owned Promptで評価するKnowledge評価方法を追加します。" />
                  <Button Content="Customを追加" Command="{Binding AddCustomEvaluatorCommand}" ToolTip.Tip="利用者がPromptを編集できるCustom評価方法を追加します。" />
                </WrapPanel>
                <ListBox
                    Classes="navigator"
                    ItemsSource="{Binding Evaluators}"
                    SelectedItem="{Binding SelectedEvaluator, Mode=TwoWay}"
                    Height="110"
                    ToolTip.Tip="選択中の設問にある通常評価方法です。選ぶと下の評価方法と評価項目が切り替わります。">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:EvaluatorDesignItemViewModel">
                      <Grid Margin="8,4" ColumnDefinitions="3*,2*,*" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding TypeContractName}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding EffectiveWeightText}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <ContentControl Content="{Binding SelectedEvaluator}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="viewModels:EvaluatorDesignItemViewModel">
                      <Border Classes="editor">
                        <StackPanel Spacing="8">
                          <TextBlock Text="選択した評価方法" Classes="heading" />
                          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="有効" ToolTip.Tip="この評価方法を通常評価へ含めるか設定します。無効なweightは割合の分母に含まれません。" />
                            <Button Content="複製" Command="{Binding DuplicateCommand}" ToolTip.Tip="この評価方法と配下の評価項目を新しい一意な識別子で複製します。" />
                            <Button Content="上へ" Command="{Binding MoveUpCommand}" ToolTip.Tip="この評価方法を一覧で1つ前へ移動します。" />
                            <Button Content="下へ" Command="{Binding MoveDownCommand}" ToolTip.Tip="この評価方法を一覧で1つ後ろへ移動します。" />
                            <Button Content="削除" Command="{Binding DeleteCommand}" ToolTip.Tip="この評価方法と配下の評価項目をdraftから削除します。" />
                          </WrapPanel>
                          <TextBlock Text="評価方法名" Classes="label" />
                          <TextBox Text="{Binding DisplayName, Mode=TwoWay}" ToolTip.Tip="この評価方法を識別する名前を入力します。" />
                          <TextBlock Text="type" Classes="label" />
                          <TextBlock Text="{Binding TypeContractName}" TextWrapping="Wrap" ToolTip.Tip="KNOWLEDGE_COVERAGEは固定Prompt、CUSTOM_PROMPTは利用者編集Promptを使います。" />
                          <TextBlock Text="weight" Classes="label" />
                          <TextBox Text="{Binding Weight, Mode=TwoWay}" ToolTip.Tip="同じ設問内の有効な評価方法どうしの相対係数です。0より大きい有限値を入力します。" />
                          <TextBlock Text="range minimum" Classes="label" />
                          <TextBox Text="{Binding Minimum, Mode=TwoWay}" ToolTip.Tip="この評価方法が使うraw score範囲の最小値です。最大値より小さくします。" />
                          <TextBlock Text="range maximum" Classes="label" />
                          <TextBox Text="{Binding Maximum, Mode=TwoWay}" ToolTip.Tip="この評価方法が使うraw score範囲の最大値です。最小値より大きくします。" />

                          <Border Classes="prompt">
                            <StackPanel Spacing="6">
                              <TextBlock Text="{Binding PromptSurfaceLabel}" FontWeight="Bold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding PromptGuidance}" Classes="muted" TextWrapping="Wrap" />
                              <TextBox Text="{Binding PromptPreview}" IsReadOnly="True" IsVisible="{Binding IsKnowledge}" AcceptsReturn="True" TextWrapping="Wrap" Height="130" AutomationProperties.AutomationId="{Binding KnowledgePromptPreviewAutomationId}" ToolTip.Tip="Knowledge評価で使うapp-owned Promptの読取専用previewです。編集はできません。" />
                              <TextBox Text="{Binding CustomPromptTemplate, Mode=TwoWay}" IsVisible="{Binding IsCustom}" AcceptsReturn="True" TextWrapping="Wrap" Height="130" AutomationProperties.AutomationId="{Binding PromptAutomationId}" ToolTip.Tip="Custom評価のPromptを入力します。{回答}と{評価項目} placeholderが必須です。" />
                              <TextBox Text="{Binding PromptPreview}" IsReadOnly="True" IsVisible="{Binding IsCustom}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" AutomationProperties.AutomationId="{Binding CustomPromptPreviewAutomationId}" ToolTip.Tip="placeholderへ安全なpreview値を入れた、AI送信前の読取専用previewです。" />
                            </StackPanel>
                          </Border>
                          <TextBlock Text="{Binding ValidationText}" IsVisible="{Binding HasErrors}" Foreground="{DynamicResource TechnicalTextBrush}" TextWrapping="Wrap" />

                          <TextBlock Text="評価項目 navigator" Classes="heading" />
                          <Button Content="評価項目を追加" Command="{Binding AddCriterionCommand}" HorizontalAlignment="Left" ToolTip.Tip="この評価方法へ新しい評価観点を追加します。" />
                          <ListBox
                              Classes="navigator"
                              ItemsSource="{Binding Criteria}"
                              SelectedItem="{Binding SelectedCriterion, Mode=TwoWay}"
                              Height="100"
                              ToolTip.Tip="この評価方法にある評価項目です。選ぶと下の項目編集欄が切り替わります。">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                              <DataTemplate x:DataType="viewModels:CriterionDesignItemViewModel">
                                <Grid Margin="8,4" ColumnDefinitions="3*,2*,*" ColumnSpacing="12">
                                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <TextBlock Grid.Column="1" Text="{Binding EffectiveRangeText}" TextWrapping="Wrap" />
                                  <TextBlock Grid.Column="2" Text="{Binding EffectiveWeightText}" TextWrapping="Wrap" />
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>

                          <ContentControl Content="{Binding SelectedCriterion}">
                            <ContentControl.ContentTemplate>
                              <DataTemplate x:DataType="viewModels:CriterionDesignItemViewModel">
                                <Border Classes="editor">
                                  <StackPanel Spacing="8">
                                    <TextBlock Text="選択した評価項目" Classes="heading" />
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                                      <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Content="有効" ToolTip.Tip="この評価項目をAI評価と加重平均へ含めるか設定します。" />
                                      <Button Content="複製" Command="{Binding DuplicateCommand}" ToolTip.Tip="この評価項目を新しい一意な識別子で複製します。" />
                                      <Button Content="上へ" Command="{Binding MoveUpCommand}" ToolTip.Tip="この評価項目を一覧で1つ前へ移動します。" />
                                      <Button Content="下へ" Command="{Binding MoveDownCommand}" ToolTip.Tip="この評価項目を一覧で1つ後ろへ移動します。" />
                                      <Button Content="削除" Command="{Binding DeleteCommand}" ToolTip.Tip="この評価項目をdraftから削除します。" />
                                    </WrapPanel>
                                    <TextBlock Text="項目名 / 知識ポイント" Classes="label" />
                                    <TextBox Text="{Binding DisplayName, Mode=TwoWay}" AutomationProperties.AutomationId="{Binding NameAutomationId}" ToolTip.Tip="AIへ示す評価観点または知識ポイントの短い名前を入力します。" />
                                    <TextBlock Text="説明" Classes="label" />
                                    <TextBox Text="{Binding Description, Mode=TwoWay}" TextWrapping="Wrap" ToolTip.Tip="この観点で何を確認するかを具体的に入力します。" />
                                    <TextBlock Text="weight" Classes="label" />
                                    <TextBox Text="{Binding Weight, Mode=TwoWay}" ToolTip.Tip="同じ評価方法内の有効な評価項目どうしの相対係数です。0より大きい有限値を入力します。" />
                                    <CheckBox IsChecked="{Binding HasCustomRange, Mode=TwoWay}" Content="個別 range" AutomationProperties.AutomationId="{Binding RangeAutomationId}" ToolTip.Tip="この評価項目だけ親のrangeと異なる最小・最大値を使う場合に有効にします。" />
                                    <TextBox Text="{Binding Minimum, Mode=TwoWay}" IsEnabled="{Binding HasCustomRange}" ToolTip.Tip="個別rangeの最小値です。個別rangeが無効な場合は親の最小値を使います。" />
                                    <TextBox Text="{Binding Maximum, Mode=TwoWay}" IsEnabled="{Binding HasCustomRange}" ToolTip.Tip="個別rangeの最大値です。個別rangeが無効な場合は親の最大値を使います。" />
                                    <TextBlock Text="{Binding EffectiveRangeText}" Classes="muted" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ValidationText}" IsVisible="{Binding HasErrors}" Foreground="{DynamicResource TechnicalTextBrush}" TextWrapping="Wrap" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ContentControl.ContentTemplate>
                          </ContentControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <Border
          x:Name="DesignValidationSummary"
          Classes.ok="{Binding IsValid}"
          Classes.invalid="{Binding HasTechnicalErrors}"
          AutomationProperties.AutomationId="DesignValidationSummary">
        <StackPanel Spacing="6">
          <TextBlock Text="snapshot preflight" FontWeight="Bold" />
          <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ValidationErrors}" IsVisible="{Binding HasTechnicalErrors}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:DesignValidationError"><TextBlock Text="{Binding AccessibleText}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="現在のdraftを再検証" Command="{Binding ValidateCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ValidateDesignDraft" ToolTip.Tip="現在の入力内容を再検証し、AI実行前に解消が必要な設定エラーを表示します。" />
        </StackPanel>
      </Border>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
