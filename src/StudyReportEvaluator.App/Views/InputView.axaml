<UserControl
    x:Class="StudyReportEvaluator.App.Views.InputView"
    x:DataType="viewModels:InputViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:StudyReportEvaluator.App.ViewModels"
    Background="{DynamicResource AppCanvasBrush}"
    Foreground="{DynamicResource AppTextBrush}"
    AutomationProperties.AutomationId="InputView"
    mc:Ignorable="d">

  <UserControl.Styles>
    <Style Selector="Border.input-card">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.input-hero">
      <Setter Property="Background" Value="{DynamicResource AppHeroBrush}" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.mapping-card">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.validation-ok">
      <Setter Property="Background" Value="{DynamicResource AppCompletedSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCompletedBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.validation-error">
      <Setter Property="Background" Value="{DynamicResource TechnicalBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TechnicalBorderBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="TextBlock.kicker">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="ListBox.flat-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.flat-list > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- 縦積みを基準にし、横並びは幅が足りる場合だけ container query で有効化する。 -->
    <Style Selector="Grid#InputMappingHost">
      <Setter Property="RowSpacing" Value="18" />
      <Setter Property="ColumnSpacing" Value="0" />
    </Style>
    <Style Selector="Grid#InputMappingHost > Border#InputRangeCard">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="Grid#InputMappingHost > Border#InputSuggestionCard">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <ContainerQuery Name="input-content" Query="min-width:880">
      <Style Selector="Grid#InputMappingHost">
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="18" />
      </Style>
      <Style Selector="Grid#InputMappingHost > Border#InputRangeCard">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="1" />
      </Style>
      <Style Selector="Grid#InputMappingHost > Border#InputSuggestionCard">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="1" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>

  <ScrollViewer
      x:Name="InputScrollViewer"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto"
      AutomationProperties.AutomationId="InputScrollViewer">
    <Grid
        x:Name="InputContentRoot"
        Container.Name="input-content"
        Container.Sizing="Width"
        Margin="24"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto"
        RowSpacing="18"
        KeyboardNavigation.TabNavigation="Continue">

      <Border Grid.Row="0" Classes="input-hero">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="7">
            <TextBlock Text="STEP 01 · INPUT" Foreground="#9FABFF" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.2" />
            <TextBlock Text="入力 workbook と mapping" Foreground="White" FontSize="28" FontWeight="Bold" />
            <TextBlock
                Text="標準 .xlsx を read-only で検証し、sheet・行範囲・任意の主回答／補助列を決めます。候補は出発点であり、すべて上書きできます。"
                Foreground="{DynamicResource AppHeroMutedBrush}"
                FontSize="14"
                TextWrapping="Wrap"
                MaxWidth="780"
                HorizontalAlignment="Left" />
          </StackPanel>
          <Border Grid.Column="1" Padding="12,8" CornerRadius="10" Background="#20AAB6FF" VerticalAlignment="Top">
            <TextBlock Text="READ-ONLY · NO OFFICE REQUIRED" Foreground="White" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="input-card">
        <StackPanel Spacing="14">
          <StackPanel Spacing="3">
            <TextBlock Text="WORKBOOK" Classes="kicker" />
            <TextBlock Text="標準 .xlsx を読み込む" Classes="heading" />
            <TextBlock Text="native picker または直接 path から選び、同じ read-only loader で検証します。" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="5">
              <TextBlock Text="ファイル path（標準 .xlsx）" Classes="label" />
              <TextBox
                  x:Name="FilePathTextBox"
                  Text="{Binding FilePath, Mode=TwoWay}"
                  TextWrapping="Wrap"
                  PlaceholderText="C:\...\responses.xlsx"
                  TabIndex="0"
                  AutomationProperties.AutomationId="InputFilePath"
                  AutomationProperties.Name="入力する標準 xlsx ファイル path" />
            </StackPanel>
            <WrapPanel
                Grid.Column="1"
                ItemSpacing="10"
                LineSpacing="8"
                VerticalAlignment="Bottom">
              <Button
                x:Name="PickFileButton"
                Content="ファイルを選択"
                Click="HandlePickFileClick"
                TabIndex="1"
                AutomationProperties.AutomationId="PickInputWorkbook"
                AutomationProperties.Name="native picker で標準 xlsx ファイルを選択" />
              <Button
                x:Name="LoadFileButton"
                  Classes="primary"
                  Content="read-only で読込"
                  Command="{Binding LoadFileCommand}"
                TabIndex="2"
                  AutomationProperties.AutomationId="LoadInputWorkbook"
                  AutomationProperties.Name="入力 Excel を read-only で読み込む" />
            </WrapPanel>
          </Grid>

            <TextBlock
              x:Name="PickerStatusMessage"
              Text=""
              IsVisible="False"
              Foreground="{DynamicResource TechnicalTextBrush}"
              TextWrapping="Wrap"
              AutomationProperties.AutomationId="InputPickerStatus" />

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding WorkbookSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ProgressBar Grid.Column="1" Width="180" IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
          </Grid>
        </StackPanel>
      </Border>

      <Grid
          x:Name="InputMappingHost"
          Grid.Row="2"
          ColumnDefinitions="2*,3*"
          RowDefinitions="Auto,Auto">
        <Border x:Name="InputRangeCard" Classes="input-card">
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="RANGE" Classes="kicker" />
              <TextBlock Text="sheet と回答行" Classes="heading" />
            </StackPanel>

            <StackPanel Spacing="5">
              <TextBlock Text="回答 sheet" Classes="label" />
              <ComboBox
                  x:Name="WorksheetComboBox"
                  ItemsSource="{Binding Worksheets}"
                  SelectedItem="{Binding SelectedWorksheetChoice, Mode=TwoWay}"
                  TabIndex="3"
                  AutomationProperties.AutomationId="InputWorksheet"
                  AutomationProperties.Name="回答 sheet">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="viewModels:WorksheetChoiceViewModel">
                    <TextBlock Text="{Binding DisplayText}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
              <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Text="質問文の行（1 または 2）" Classes="label" />
                <ComboBox
                  x:Name="HeaderRowComboBox"
                  ItemsSource="{Binding HeaderRowOptions}"
                  SelectedItem="{Binding HeaderRow, Mode=TwoWay}"
                  TabIndex="4"
                    AutomationProperties.AutomationId="InputHeaderRow"
                  AutomationProperties.Name="質問文の行 1 または 2" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="回答開始行" Classes="label" />
                <TextBox
                    Text="{Binding FirstDataRow, Mode=TwoWay}"
                    TabIndex="5"
                    AutomationProperties.AutomationId="InputFirstDataRow"
                    AutomationProperties.Name="回答開始行番号" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="5">
                <TextBlock Text="回答終了行" Classes="label" />
                <TextBox
                    Text="{Binding LastDataRow, Mode=TwoWay}"
                    TabIndex="6"
                    AutomationProperties.AutomationId="InputLastDataRow"
                    AutomationProperties.Name="回答終了行番号" />
              </StackPanel>
            </Grid>

            <Button
                Content="見出し行を再読込"
                Command="{Binding RefreshHeaderCommand}"
                HorizontalAlignment="Left"
                TabIndex="7"
                AutomationProperties.AutomationId="RefreshInputHeader"
                AutomationProperties.Name="指定した見出し行で workbook metadata を再読込" />
          </StackPanel>
        </Border>

        <Border x:Name="InputSuggestionCard" Classes="input-card">
          <StackPanel Spacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="X-02 SUGGESTIONS" Classes="kicker" />
              <TextBlock Text="列候補" Classes="heading" />
              <TextBlock Text="{Binding SuggestionStatusText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ListBox
                x:Name="MappingSuggestionList"
                Classes="flat-list"
                ItemsSource="{Binding MappingSuggestions}"
                Height="230"
                SelectionMode="Single"
                AutomationProperties.AutomationId="InputMappingSuggestions"
                AutomationProperties.Name="X-02 列 mapping 候補">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:MappingSuggestionViewModel">
                  <Border Classes="mapping-card" Padding="12">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Text="{Binding ColumnName}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding RoleText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                      </Grid>
                      <TextBlock Text="{Binding HeaderText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding SupportText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button
                Content="候補を再適用"
                Command="{Binding ApplySuggestionsCommand}"
                HorizontalAlignment="Left"
                TabIndex="7"
                AutomationProperties.AutomationId="ApplyInputSuggestions"
                AutomationProperties.Name="X-02 の列候補を mapping へ再適用" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="3" Classes="input-card">
        <Grid RowDefinitions="Auto,*" RowSpacing="14">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="QUESTION MAPPING" Classes="kicker" />
              <TextBlock Text="質問ごとの主回答列と補助列" Classes="heading" />
              <TextBlock Text="学生 Prompt 列を含む任意列を主回答にでき、同じ列を別質問でも使用できます。" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Classes="primary"
                Content="＋ 質問 mapping"
                Command="{Binding AddQuestionCommand}"
                VerticalAlignment="Center"
                TabIndex="20"
                AutomationProperties.AutomationId="AddInputQuestion"
                AutomationProperties.Name="質問 mapping を追加" />
          </Grid>

          <ListBox
              x:Name="InputQuestionList"
              Grid.Row="1"
              Classes="flat-list"
              ItemsSource="{Binding Questions}"
              MaxHeight="720"
              MinHeight="120"
              SelectionMode="Single"
              AutomationProperties.AutomationId="InputQuestionMappings"
              AutomationProperties.Name="質問 mapping 一覧">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="viewModels:InputQuestionMappingViewModel">
                <Border Classes="mapping-card">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <CheckBox
                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                          Content="有効"
                          AutomationProperties.Name="この質問 mapping を有効化または無効化" />
                      <TextBlock Grid.Column="1" Text="{Binding Id}" Classes="muted" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <WrapPanel Grid.Column="2" ItemSpacing="6" LineSpacing="6">
                        <Button Classes="compact" Content="複製" Command="{Binding DuplicateCommand}" AutomationProperties.Name="質問 mapping を複製" />
                        <Button Classes="compact" Content="↑" Command="{Binding MoveUpCommand}" AutomationProperties.Name="質問 mapping を上へ移動" />
                        <Button Classes="compact" Content="↓" Command="{Binding MoveDownCommand}" AutomationProperties.Name="質問 mapping を下へ移動" />
                        <Button Classes="compact" Content="削除" Command="{Binding DeleteCommand}" AutomationProperties.Name="質問 mapping を削除" />
                      </WrapPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,2*" ColumnSpacing="12">
                      <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="表示名" Classes="label" />
                        <TextBox
                            Text="{Binding DisplayName, Mode=TwoWay}"
                          AutomationProperties.AutomationId="{Binding NameAutomationId}"
                            AutomationProperties.Name="質問の表示名" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="設問 text" Classes="label" />
                        <TextBox Text="{Binding QuestionText, Mode=TwoWay}" TextWrapping="Wrap" AutomationProperties.Name="評価する設問 text" />
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="主回答列" Classes="label" />
                        <ComboBox
                            ItemsSource="{Binding AvailableColumnNames}"
                            SelectedItem="{Binding PrimarySourceColumn, Mode=TwoWay}"
                            AutomationProperties.AutomationId="{Binding PrimaryAutomationId}"
                            AutomationProperties.Name="この質問の主回答列" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="補助列（0 件以上）" Classes="label" />
                        <ListBox
                            ItemsSource="{Binding SupportingColumns}"
                            Height="150"
                            SelectionMode="Single"
                            AutomationProperties.AutomationId="{Binding SupportingAutomationId}"
                            AutomationProperties.Name="この質問の補助列">
                          <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                              <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                          </ListBox.ItemsPanel>
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:SupportingColumnSelectionViewModel">
                              <CheckBox
                                  Content="{Binding DisplayText}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSelect}"
                                  AutomationProperties.Name="{Binding DisplayText}" />
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding SupportingSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border
          x:Name="InputValidationSummary"
          Grid.Row="4"
          Classes.validation-ok="{Binding IsTechnicallyValid}"
          Classes.validation-error="{Binding HasTechnicalErrors}"
          AutomationProperties.AutomationId="InputValidationSummary">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <TextBlock Text="◆" Foreground="{DynamicResource TechnicalTextBrush}" FontSize="16" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="7">
            <TextBlock Text="技術検証" FontWeight="Bold" />
            <TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" />
            <ListBox
                x:Name="InputValidationErrorList"
                ItemsSource="{Binding ValidationErrors}"
                MaxHeight="180"
                IsVisible="{Binding HasTechnicalErrors}"
                AutomationProperties.AutomationId="InputTechnicalErrors"
                AutomationProperties.Name="入力の技術検証エラー">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:InputValidationError">
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>