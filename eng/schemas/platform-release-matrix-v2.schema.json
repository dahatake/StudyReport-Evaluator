      }
    },
    "singleFileRuntime": {
      "$comment": "Exactly the five runtime fields emitted by P07. cliSha256 is measured uppercase SHA-256, not an invented fixed hash. C02 must verify the actual bundled CLI identity and cross-bind it and all four fixed versions across package evidence; the observer's installed runtime is not the bundled runtime.",
      "type": "object",
      "additionalProperties": false,
      "required": ["dotnetSdk", "dotnetRuntime", "copilotSdk", "cliVersion", "cliSha256"],
      "properties": {
        "dotnetSdk": {
          "const": "10.0.400"
        },
        "dotnetRuntime": {
          "const": "10.0.11"
        },
        "copilotSdk": {
          "const": "1.0.11"
        },
        "cliVersion": {
          "const": "1.0.79"
        },
        "cliSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "singleFilePackageEvidence": {
      "$comment": "Separately received StudyReportEvaluator-win-x64.exe.evidence.json: the exact closed P07 scripts/test-windows-singlefile.ps1 shape, restricted to clean-checkout PASS_REQUIRED. PASS_DEVELOPMENT is never accepted or upgraded, even after seven passed tests and nine P06 observations. sourceStatusSha256 is SHA-256 of empty porcelain-v1 -z bytes; sourceContentSha256 is the P07 source-inventory digest, not sourceCommit. C02 must bind these claims to the actual candidate/source/package evidence and check the referenced files, not merely trust counters, check flags or renamed evidence. P07 verifies its seven exact TRX methods and nine observation ownerships; raw observations/logs are not exported here. This remains development-host package evidence, never network isolation, personal authentication or live-AI proof.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "evidenceKind",
        "status",
        "sourceCommit",
        "sourceStatusEntryCount",
        "sourceStatusSha256",
        "sourceContentSha256",
        "productVersion",
        "host",
        "package",
        "runtime",
        "tests",
        "checks",
        "limitations"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "evidenceKind": {
          "const": "windows-singlefile-required"
        },
        "status": {
          "const": "PASS_REQUIRED"
        },
        "sourceCommit": {
          "$ref": "#/$defs/sourceCommit"
        },
        "sourceStatusEntryCount": {
          "const": 0
        },
        "sourceStatusSha256": {
          "const": "E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855"
        },
        "sourceContentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "productVersion": {
          "$ref": "#/$defs/stableProductVersion"
        },
        "host": {
          "$ref": "#/$defs/windowsVerification"
        },
        "package": {
          "$ref": "#/$defs/windowsSingleFileArtifact"
        },
        "runtime": {
          "$ref": "#/$defs/singleFileRuntime"
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "skipped", "results", "trx"],
          "properties": {
            "total": { "const": 7 },
            "passed": { "const": 7 },
            "failed": { "const": 0 },
            "skipped": { "const": 0 },
            "results": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "status"],
                "properties": {
                  "id": {
                    "enum": [
                      "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_cold_and_warm_start_validate_payload_and_show_input",
                      "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_missing_cached_CLI_is_recovered_by_the_standard_host",
                      "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_deleted_cache_is_reextracted_after_moving_the_EXE",
                      "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_two_instances_share_cache_and_close_independently",
                      "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_relative_input_and_two_prompts_are_observed_in_GUI_order",
                      "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_file_valued_extraction_base_fails_without_changing_data",
                      "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_truncated_bundle_reports_a_host_error_without_changing_data"
                    ]
                  },
                  "status": {
                    "const": "PASS"
                  }
                }
              },
              "allOf": [
                {
                  "contains": {
                    "const": {
                      "id": "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_cold_and_warm_start_validate_payload_and_show_input",
                      "status": "PASS"
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "const": {
                      "id": "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_missing_cached_CLI_is_recovered_by_the_standard_host",
                      "status": "PASS"
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "const": {
                      "id": "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_deleted_cache_is_reextracted_after_moving_the_EXE",
                      "status": "PASS"
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "const": {
                      "id": "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_two_instances_share_cache_and_close_independently",
                      "status": "PASS"
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "const": {
                      "id": "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_relative_input_and_two_prompts_are_observed_in_GUI_order",
                      "status": "PASS"
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "const": {
                      "id": "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_file_valued_extraction_base_fails_without_changing_data",
                      "status": "PASS"
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "const": {
                      "id": "StudyReportEvaluator.App.Tests.Packaging.WindowsSingleFilePackageTests.Single_file_truncated_bundle_reports_a_host_error_without_changing_data",
                      "status": "PASS"
                    }
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ]
            },
            "trx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fileName", "bytes", "sha256"],
              "properties": {
                "fileName": {
                  "const": "windows-singlefile.trx"
                },
                "bytes": {
                  "$ref": "#/$defs/positiveFileSize"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "singleFileVerified",
            "sidecarVerified",
            "safeLayoutVerified",
            "bundledCliVerified",
            "documentationVerified",
            "guiLaunchVerified",
            "restartAndConcurrencyVerified",
            "inputUnchangedVerified"
