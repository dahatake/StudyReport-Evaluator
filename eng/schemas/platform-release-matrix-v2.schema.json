{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:study-report-evaluator:platform-release-matrix:v2",
  "title": "StudyReport Evaluator Windows release matrix v2",
  "$comment": "C01 structural contract for requirements v4.5 sections 13.6/13.7 and ADR-0016. Schema validity is necessary, never sufficient for publication. C02 must reject duplicate JSON member names before validation; bind the expected repository, successful .github/workflows/release.yml candidate run, tag/source commit and stable product version; and cross-bind this matrix, the separately received candidateRecord and singleFilePackageEvidence. Validate those documents through their $defs entry points with this document's complete $defs available. C02 must compare exact basenames, byte counts, SHA-256 values, sidecar bytes, package/runtime identities and candidate descriptors against the actual candidate records and re-downloaded EXE/ZIP assets. C03 may generate this final matrix only after those checks pass. Candidate creation must verify the actual development MSIX before recording its descriptors; final validation uses only its candidate-bound descriptors, evidence and sidecar, never requires or claims re-validation of an uploaded MSIX binary. Only EXE, ZIP and their two sidecars are public assets. No schema match, hash or PASS field automatically proves execution, a fresh host, authentication, publisher identity or production trust. No new platform, workflow or storage contract is introduced.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productVersion",
    "sourceCommit",
    "candidate",
    "candidateRecord",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "productVersion": {
      "$ref": "#/$defs/stableProductVersion"
    },
    "sourceCommit": {
      "$ref": "#/$defs/sourceCommit"
    },
    "candidate": {
      "$ref": "#/$defs/candidateIdentity"
    },
    "candidateRecord": {
      "$ref": "#/$defs/candidateRecordDescriptor"
    },
    "rows": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/windowsSingleFileRow" },
          { "$ref": "#/$defs/windowsZipRow" },
          { "$ref": "#/$defs/windowsDevelopmentMsixRow" }
        ]
      },
      "allOf": [
        {
          "contains": { "$ref": "#/$defs/windowsSingleFileRow" },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "$ref": "#/$defs/windowsZipRow" },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "$ref": "#/$defs/windowsDevelopmentMsixRow" },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "stableProductVersion": {
      "$comment": "Stable three-component SemVer only. The final negative lookahead also rejects trailing line terminators that a bare regex $ can accept.",
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])"
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9A-F]{64}$"
    },
    "positiveFileSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "windowsOsVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$(?![\\s\\S])"
    },
    "windowsOsBuild": {
      "type": "integer",
      "minimum": 22000,
      "maximum": 2147483647
    },
    "windowsVerification": {
      "$comment": "P07 reports Windows, not Windows 11 inferred from a build number. C02 must bind this metadata to the corresponding package evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "osName",
        "osVersion",
        "osBuild",
        "osArchitecture",
        "processArchitecture"
      ],
      "properties": {
        "osName": {
          "enum": ["Windows", "Windows 11"]
        },
        "osVersion": {
          "$ref": "#/$defs/windowsOsVersion"
        },
        "osBuild": {
          "$ref": "#/$defs/windowsOsBuild"
        },
        "osArchitecture": {
          "const": "X64"
        },
        "processArchitecture": {
          "const": "X64"
        }
      }
    },
    "candidateIdentity": {
      "$comment": "The repository is a bounded ASCII owner/name, not a URL or an allowlist decision. C02 must bind it to the expected actual repository and verify the workflow/run through trusted candidate metadata. Keep runId as a positive decimal string without numeric coercion or precision loss.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "runId"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$(?![\\s\\S])"
        },
        "workflow": {
          "const": ".github/workflows/release.yml"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[1-9][0-9]*$(?![\\s\\S])"
        }
      }
    },
    "candidateRecordDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "release-candidate-record.json"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsSingleFileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.exe"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsSingleFileSidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.exe.sha256"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsSingleFileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.exe.evidence.json"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsZipArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.zip"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsZipSidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.zip.sha256"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsZipEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.evidence.json"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsDevelopmentMsixArtifact": {
      "$comment": "Descriptor of the actual MSIX verified during candidate creation. The binary is neither a public asset nor an uploaded Actions artifact; C02 final validation binds this descriptor to that candidate record without requiring the MSIX binary.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.unsigned.test.msix"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsDevelopmentMsixSidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.unsigned.test.msix.sha256"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsDevelopmentMsixEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": {
          "const": "StudyReportEvaluator-win-x64.unsigned.test.evidence.json"
        },
        "bytes": {
          "$ref": "#/$defs/positiveFileSize"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "windowsSingleFileRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "platform",
        "runtimeIdentifier",
        "publish",
        "status",
        "verification",
        "artifact",
        "sidecar",
        "evidence"
      ],
      "properties": {
        "artifactKind": {
          "const": "windows-singlefile-exe"
        },
        "platform": {
          "const": "windows"
        },
        "runtimeIdentifier": {
          "const": "win-x64"
        },
        "publish": {
          "const": true
        },
        "status": {
          "const": "PASS_REQUIRED"
        },
        "verification": {
          "$ref": "#/$defs/windowsVerification"
        },
        "artifact": {
          "$ref": "#/$defs/windowsSingleFileArtifact"
        },
        "sidecar": {
          "$ref": "#/$defs/windowsSingleFileSidecar"
        },
        "evidence": {
          "$ref": "#/$defs/windowsSingleFileEvidence"
        }
      }
    },
    "windowsZipRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "platform",
        "runtimeIdentifier",
        "publish",
        "status",
        "verification",
        "artifact",
        "sidecar",
        "evidence"
      ],
      "properties": {
        "artifactKind": {
          "const": "windows-zip"
        },
        "platform": {
          "const": "windows"
        },
        "runtimeIdentifier": {
          "const": "win-x64"
        },
        "publish": {
          "const": true
        },
        "status": {
          "const": "PASS_REQUIRED"
        },
        "verification": {
          "$ref": "#/$defs/windowsVerification"
        },
        "artifact": {
          "$ref": "#/$defs/windowsZipArtifact"
        },
        "sidecar": {
          "$ref": "#/$defs/windowsZipSidecar"
        },
        "evidence": {
          "$ref": "#/$defs/windowsZipEvidence"
        }
      }
    },
    "windowsDevelopmentMsixRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactKind",
        "platform",
        "runtimeIdentifier",
        "publish",
        "status",
        "verification",
        "artifact",
        "sidecar",
        "evidence"
      ],
      "properties": {
        "artifactKind": {
          "const": "windows-development-msix"
        },
        "platform": {
          "const": "windows"
        },
        "runtimeIdentifier": {
          "const": "win-x64"
        },
        "publish": {
          "const": false
        },
        "status": {
          "const": "PASS_MECHANISM"
        },
        "verification": {
          "$ref": "#/$defs/windowsVerification"
        },
        "artifact": {
          "$ref": "#/$defs/windowsDevelopmentMsixArtifact"
        },
        "sidecar": {
          "$ref": "#/$defs/windowsDevelopmentMsixSidecar"
        },
        "evidence": {
          "$ref": "#/$defs/windowsDevelopmentMsixEvidence"
        }
      }
    },
    "candidateRecord": {
      "$comment": "Separately received release-candidate-record.json. This is a package/descriptors record, not the final matrix. Its three rows intentionally have no platform, runtimeIdentifier, publish or status fields. C02 must verify the candidate's actual package/mechanism test record, identities and descriptors.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "evidenceKind",
        "productVersion",
        "sourceCommit",
        "candidate",
        "requiredTests",
        "rows"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "evidenceKind": {
          "const": "windows-release-candidate"
        },
        "productVersion": {
          "$ref": "#/$defs/stableProductVersion"
        },
        "sourceCommit": {
          "$ref": "#/$defs/sourceCommit"
        },
        "candidate": {
          "$ref": "#/$defs/candidateIdentity"
        },
        "requiredTests": {
          "const": "PASS"
        },
        "rows": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/windowsSingleFileCandidateRow" },
              { "$ref": "#/$defs/windowsZipCandidateRow" },
              { "$ref": "#/$defs/windowsDevelopmentMsixCandidateRow" }
            ]
          },
          "allOf": [
            {
              "contains": { "$ref": "#/$defs/windowsSingleFileCandidateRow" },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": { "$ref": "#/$defs/windowsZipCandidateRow" },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": { "$ref": "#/$defs/windowsDevelopmentMsixCandidateRow" },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "windowsSingleFileCandidateRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "verification", "artifact", "sidecar", "evidence"],
      "properties": {
        "artifactKind": {
          "const": "windows-singlefile-exe"
        },
        "verification": {
          "$ref": "#/$defs/windowsVerification"
        },
        "artifact": {
          "$ref": "#/$defs/windowsSingleFileArtifact"
        },
        "sidecar": {
